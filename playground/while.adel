var i = 1;
var sum = 0;
while i <= 10 {
    sum = sum + i;
    i = i + 1;
}
print sum;

var n = 3;
while n > 0 {
    print n;
    n = n - 1;
}

while 0 {
    print 999;
}

var evens = 0;
var k = 0;
while k < 10 {
    if k % 2 == 0 {
        evens = evens + 1;
    }
    k = k + 1;
}
print evens;

var row = 1;
var total = 0;
while row <= 3 {
    var col = 1;
    while col <= 3 {
        total = total + row * col;
        col = col + 1;
    }
    row = row + 1;
}
print total;

var a = 0;
var b = 1;
var count = 0;
while count < 10 {
    var next = a + b;
    a = b;
    b = next;
    count = count + 1;
}
print a;
