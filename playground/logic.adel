print true and true;
print true and false;
print false or true;
print false or false;

print 3 > 2 and 2 > 1;
print 1 + 1 == 2 or 5 > 9;
print false and true or true;
print true or false and false;
print !(true and false);

var x = 0;
print x != 0 and 10 / x > 1;
print x == 0 or 10 / x > 1;

fun sideEffect() -> bool {
    print 999;
    return true;
}
print false and sideEffect();
print true or sideEffect();
print true and sideEffect();

var a = 5;
var b = 10;
if a < b and b < 20 {
    print 100;
}
if a > b or b == 10 {
    print 200;
}

var i = 0;
var count = 0;
while i < 20 and count < 3 {
    if i % 2 == 0 or i % 5 == 0 {
        count = count + 1;
    }
    i = i + 1;
}
print count;
print i;
